<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.mafbase_stream">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- API 34+: типы foreground service стрима (camera|microphone) требуют своих разрешений. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Нотификации фоновой трансляции и прогресса сохранения записи; на API 33+ без этого
         разрешения они молча подавляются. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application>
        <activity
            android:name=".StreamActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <activity
            android:name=".OverlayPreviewActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- shortService: сохранение занимает секунды-минуты и не требует ни отдельного
             разрешения, ни декларации типа в Play Console (в отличие от dataSync). -->
        <service
            android:name=".SaveToGalleryService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <!-- Держит камеру, запись и стрим живыми, пока StreamActivity свёрнута или
             перекрыта другим окном. -->
        <service
            android:name=".service.StreamForegroundService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />
    </application>
</manifest>
